# Copy to .env for local development. Every variable the process reads is here.
APP_ENV=development
PORT=8090
DATABASE_URL=postgres://fieldkit:fieldkit@localhost:5432/fieldkit?sslmode=disable
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Where uploaded photos are written.
DATA_DIR=./data
# true mounts POST /__control so the presenter can make the API fail on demand.
DEMO_CONTROL=true
LOG_LEVEL=info
